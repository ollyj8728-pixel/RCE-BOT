DISCORD_TOKEN=replace_me
DISCORD_CLIENT_ID=replace_me
# Optional: set this to your Discord server ID for instant command updates while testing.
# Remove it for global commands after testing (global updates can take up to an hour).
DISCORD_GUILD_ID=replace_me
DB_PATH=./rce-bot.sqlite
LOG_LEVEL=info
# Optional: public URLs for the Rustworks logo and banner.
BRAND_LOGO_URL=https://your-public-host/rustworks-logo.gif
BRAND_BANNER_URL=https://your-public-host/rustworks-banner.png
# Add your RCON adapter settings only in your private .env; never commit secrets.
